    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingExtractor.Domain\MeetingExtractor.Domain.csproj" />
    <ProjectReference Include="..\MeetingExtractor.Infrastructure\MeetingExtractor.Infrastructure.csproj" />
  </ItemGroup>

</Project>
